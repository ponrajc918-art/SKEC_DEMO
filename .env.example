# =============================================================================
# SKEC Digital Campus - environment template
# Copy to .env (never commit .env). Every value below is a PLACEHOLDER.
# Generate real secrets locally or in the hosting provider's secret store.
# =============================================================================

# ---- General ----
APP_ENV=development                 # development | staging | production
APP_NAME="SKEC Digital Campus"
PUBLIC_SITE_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
TIMEZONE=Asia/Kolkata

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_SITE_NAME="Sri Krishna Engineering College"
NEXT_PUBLIC_API_BASE_PATH=/api      # same-origin path proxied to the backend
NEXT_PUBLIC_SHOW_PLACEHOLDER_LABELS=true   # shows "photograph pending" captions in dev
INTERNAL_API_URL=http://backend:8000       # server-to-server URL used by Next.js on the Docker network

# ---- Backend (FastAPI) ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# ---- Database (PostgreSQL) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=skec_campus
POSTGRES_USER=skec_app
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://skec_app:CHANGE_ME@localhost:5432/skec_campus

# ---- Sessions and security ----
SESSION_SECRET=replace-with-a-random-secret-of-at-least-48-characters
SESSION_COOKIE_NAME=skec_session
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
PASSWORD_HISTORY_COUNT=5
FIELD_ENCRYPTION_KEY=generate-a-valid-fernet-key
MFA_ISSUER_NAME="SKEC Digital Campus"
MFA_REQUIRED_ROLES=principal,hod,college_admin,finance_admin
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4
LOGIN_RATE_LIMIT_PER_MINUTE=5

# ---- Cache / queue (introduced in Phase 5 if required) ----
REDIS_URL=redis://redis:6379/0

# ---- Private object storage (S3-compatible; MinIO in development) ----
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=replace-with-storage-access-key
STORAGE_SECRET_KEY=replace-with-storage-secret-key
STORAGE_BUCKET_PRIVATE=skec-private
STORAGE_BUCKET_PUBLIC_MEDIA=skec-public-media
SIGNED_URL_TTL_SECONDS=120

# ---- Email (SMTP provider chosen later) ----
SMTP_HOST=__SMTP_HOST__
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=replace-with-gmail-app-password
EMAIL_FROM_ADDRESS=__NO_REPLY_ADDRESS_ON_COLLEGE_DOMAIN__
EMAIL_MODE=mock                    # mock | smtp | disabled; production uses smtp or disabled
SMTP_USE_TLS=true

# ---- SMS / OTP (generic provider adapter; disabled never pretends to send) ----
SMS_PROVIDER=disabled               # disabled | generic_http
SMS_ENDPOINT=__SMS_PROVIDER_ENDPOINT__
SMS_API_TOKEN=replace-with-sms-provider-token
SMS_SENDER_ID=__SMS_SENDER_ID__
DEFAULT_COUNTRY_CODE=+91
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---- Malware scanning (private uploads remain unavailable if scanner is down) ----
FILE_SCANNER_MODE=disabled          # disabled | clamd
CLAMD_HOST=clamd
CLAMD_PORT=3310
CLAMD_TIMEOUT_SECONDS=15

# ---- Payments (Razorpay adapter, Phase 5; TEST MODE FIRST) ----
PAYMENT_PROVIDER=razorpay
PAYMENT_MODE=test                   # test | live  (live needs written college approval)
ALLOW_LIVE_PAYMENTS=false
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-razorpay-test-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

# ---- Observability (optional) ----
SENTRY_DSN=
