# Copy to .env.production on the deployment server. Never commit the completed file.
APP_ENV=production
DOMAIN=campus.example.edu.in
POSTGRES_DB=skec_campus
POSTGRES_USER=skec_app
POSTGRES_PASSWORD=change-this-local-password
SESSION_SECRET=PUT_YOUR_SECRET_KEY
FIELD_ENCRYPTION_KEY=PUT_YOUR_ENCRYTION_KEY
PASSWORD_HISTORY_COUNT=5
MFA_ISSUER_NAME="SKEC Digital Campus"
MFA_REQUIRED_ROLES=principal,hod,college_admin
EMAIL_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=ponrajc918@gmail.com
SMTP_PASSWORD=PUT_YOUR_PASSWORD
EMAIL_FROM_ADDRESS=chandruponraj06@gmail.com
SMTP_USE_TLS=true
SMS_PROVIDER=disabled
SMS_ENDPOINT=__SMS_PROVIDER_ENDPOINT__
SMS_API_TOKEN=replace-with-sms-provider-token
SMS_SENDER_ID=__SMS_SENDER_ID__
DEFAULT_COUNTRY_CODE=+91
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
PAYMENT_MODE=test
ALLOW_LIVE_PAYMENTS=false
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-razorpay-test-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret
PRIVATE_STORAGE_ROOT=/var/lib/skec-private
PRIVATE_UPLOAD_MAX_BYTES=10485760
FILE_SCANNER_MODE=disabled
CLAMD_HOST=__CLAMD_HOST_IF_ENABLED__
CLAMD_PORT=3310
CLAMD_TIMEOUT_SECONDS=15
